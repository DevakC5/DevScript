# test_libs.dev — Testing the new library system

import "vision.dev"
import "chart.dev"

say "--- Testing Vision ---"
let my_img = imread("test.jpg")
say "Image loaded: " + my_img

let blurred = blur(my_img, 5)
say "Blurred image: " + blurred

let gray = grayscale(my_img)
say "Gray image: " + gray

imwrite("out.jpg", gray)

say ""
say "--- Testing Chart ---"
let labels = ["Jan", "Feb", "Mar", "Apr"]
let values = [10, 25, 15, 30]

bar(labels, values)
line(labels, values)
