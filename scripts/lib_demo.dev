# lib_demo.dev — Showcasing new Library Features

import "vision.dev"
import "chart.dev"

say "=== Vision Features ==="
let img = imread("input.png")
let small = resize(img, 100, 100)
let rotated = rotate(small, 90)
let edges = canny(rotated)

say "Pipeline: " + edges

say ""
say "=== Chart Features ==="

# Scatter Plot
let x_coords = [1, 2, 3, 5, 8]
let y_coords = [2, 4, 1, 3, 5]
scatter(x_coords, y_coords)

# Histogram
let data = [1, 2, 2, 3, 3, 3, 4, 4, 5, 8, 9, 10, 11, 12]
hist(data, 5)
