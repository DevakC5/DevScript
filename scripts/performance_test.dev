# performance_test.dev — Stress Testing DevLang v3.1

say "=== DevLang Performance Benchmark ==="

# 1. Loop and Arithmetic Performance
let start_loop = time()
let count = 0
let i = 0
while i < 5000 ->
    let count = count + i
    let i = i + 1
end
let end_loop = time()
let loop_time = end_loop - start_loop
say "1. 5000 Iterations (Loop + Arithmetic): " + loop_time + "s"

# 2. Vectorized Math Performance (NumPy-like)
let start_vec = time()
let large_list = arange(100)
let j = 0
while j < 5000 ->
    let large_list = (large_list * 2) / 2
    let j = j + 1
end
let end_vec = time()
let vec_time = end_vec - start_vec
say "2. 5000 Vectorized Ops (100-element list): " + vec_time + "s"

# 3. Library Import & Call Performance
let start_lib = time()
import "img"
import "charts"
let img = imread("bench.jpg")
let res = resize(img, 500, 500)
let gray = grayscale(res)
let end_lib = time()
let lib_time = end_lib - start_lib
say "3. Library Imports + Vision Pipeline: " + lib_time + "s"

say ""
say "--- Performance Summary ---"
say "Total Bench Time: " + (loop_time + vec_time + lib_time) + "s"
