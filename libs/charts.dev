# charts.dev — SVG chart rendering (pure DevLang)

def _save(filename, content) ->
  if not filename.contains(".") -> let filename = filename + ".svg" end
  file_write(filename, content)
  return "Saved chart to " + filename
end

def bar(labels, values) ->
  return bar_save("bar_chart.svg", labels, values, "Bar Chart")
end

def bar_save(filename, labels, values, title) ->
  let n = labels.len()
  let max_val = max(values)
  if max_val == 0 -> let max_val = 1 end
  let w = 600
  let h = 400
  let bw = (w - 80) / n - 10
  if bw < 20 -> let bw = 20 end
  let svg = "<svg xmlns='http://www.w3.org/2000/svg' width='" + w + "' height='" + h + "'>"
  let svg = svg + "<rect width='100%' height='100%' fill='white'/>"
  let svg = svg + "<text x='300' y='25' text-anchor='middle' font-size='16' font-weight='bold'>" + title + "</text>"
  let i = 0
  while i < n ->
    let bh = (values[i] / max_val) * (h - 80)
    let x = 50 + i * (bw + 10)
    let y = h - 40 - bh
    let r = (i * 60) % 255
    let g = (i * 120) % 255
    let svg = svg + "<rect x='" + x + "' y='" + y + "' width='" + bw + "' height='" + bh + "' fill='rgb(" + r + "," + g + ",204)' />"
    let svg = svg + "<text x='" + (x + bw / 2) + "' y='" + (h - 20) + "' text-anchor='middle' font-size='10'>" + labels[i] + "</text>"
    let i = i + 1
  end
  let svg = svg + "</svg>"
  return _save(filename, svg)
end

def line(labels, values) ->
  return line_save("line_chart.svg", labels, values, "Line Chart")
end

def line_save(filename, labels, values, title) ->
  let n = labels.len()
  let max_val = max(values)
  if max_val == 0 -> let max_val = 1 end
  let w = 600
  let h = 400
  let pts = ""
  let i = 0
  while i < n ->
    if n > 1 ->
      let x = 50 + i * ((w - 80) / (n - 1))
    else
      let x = 300
    end
    let y = h - 40 - (values[i] / max_val) * (h - 80)
    if i > 0 -> let pts = pts + " " end
    let pts = pts + x + "," + y
    let i = i + 1
  end
  let svg = "<svg xmlns='http://www.w3.org/2000/svg' width='" + w + "' height='" + h + "'>"
  let svg = svg + "<rect width='100%' height='100%' fill='white'/>"
  let svg = svg + "<text x='300' y='25' text-anchor='middle' font-size='16' font-weight='bold'>" + title + "</text>"
  let svg = svg + "<polyline points='" + pts + "' fill='none' stroke='#4682b4' stroke-width='2' />"
  let svg = svg + "</svg>"
  return _save(filename, svg)
end

def scatter(x_vals, y_vals) ->
  return line_save("scatter.svg", x_vals, y_vals, "Scatter Plot")
end

def save(filename, labels, values, title) ->
  return bar_save(filename, labels, values, title)
end

def save_line(filename, labels, values, title) ->
  return line_save(filename, labels, values, title)
end
