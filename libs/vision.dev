# vision.dev — Computer Vision Library for DevLang

def imread(path) ->
    return cv_imread(path)
end

def imwrite(path, img) ->
    return cv_imwrite(path, img)
end

def blur(img, k) ->
    return cv_blur(img, k)
end

def grayscale(img) ->
    return cv_gray(img)
end

def resize(img, w, h) ->
    return cv_resize(img, w, h)
end

def rotate(img, angle) ->
    return cv_rotate(img, angle)
end

def threshold(img, val) ->
    return cv_threshold(img, val)
end

def canny(img) ->
    return cv_canny(img)
end
