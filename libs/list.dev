# libs/list.dev — list utilities

def first(lst) ->
    if lst.len() == 0 ->
        return 0
    end
    return lst[0]
end

def last(lst) ->
    let n = lst.len()
    if n == 0 ->
        return 0
    end
    return lst[n - 1]
end

def reverse(lst) ->
    let result = []
    let i = lst.len() - 1
    while i >= 0 ->
        result.append(lst[i])
        let i = i - 1
    end
    return result
end

def contains(lst, val) ->
    let i = 0
    while i < lst.len() ->
        if lst[i] == val ->
            return true
        end
        let i = i + 1
    end
    return false
end
